# AgentTable — environment configuration
# Copy this file to `.env` and fill in what you need. Everything is optional:
# without an LLM key the system runs against a deterministic MockLLM (fine for
# tests / a quick offline look, but the agents won't say anything meaningful).

# --- LLM (OpenAI-compatible; default target: DeepSeek) ---
# Works with any OpenAI-compatible endpoint (DeepSeek, OpenRouter, Ollama, ...).
# Shared defaults for every agent role; per-role overrides below take precedence.
# Note: deepseek-v4-flash runs in "thinking" mode by default — noticeably more
# reliable at tool-calling than the (deprecated) deepseek-chat, and still fast.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.7

# Per-role overrides (optional). Empty -> falls back to the shared LLM_* values.
# The admin/moderator often benefits from a stronger model.
LLM_PERSON_MODEL=
LLM_ADMIN_MODEL=
LLM_SEARCH_MODEL=

# --- Web search provider (used by the researcher agent) ---
# One of: none | tavily | searxng
#   none    -> researcher answers from model knowledge (clearly flagged).
#   tavily  -> Tavily API (needs TAVILY_API_KEY; free tier, no card required).
#   searxng -> a SearXNG instance (needs SEARXNG_BASE_URL).
# If SEARCH_PROVIDER=tavily AND SEARXNG_BASE_URL is set, Tavily is primary and
# SearXNG is used automatically as fallback (e.g. when the Tavily quota is hit).
SEARCH_PROVIDER=none
TAVILY_API_KEY=
SEARXNG_BASE_URL=

# --- App ---
# Public base path when served behind a reverse proxy under a sub-path (e.g. /agenttable).
BASE_PATH=
# SQLite file location.
DB_PATH=data/agenttable.db
# Hard per-negotiation LLM call budget — a runaway-loop backstop, not a cost lever.
# Only negotiation-phase calls count; the user-driven collecting phase is not capped.
TASK_LLM_BUDGET=200
# Timezone label used for slot display (logic is tz-naive Europe/Berlin in the MVP).
APP_TIMEZONE=Europe/Berlin
