# AgentTable — environment configuration
# Copy to .env and fill in. All values are optional; without an LLM key the
# system runs against a deterministic MockLLM (useful for tests / offline demo).

# --- LLM (OpenAI-compatible; default target: DeepSeek) ---
# Shared defaults for every agent role. Per-role overrides below take precedence.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7

# Per-role overrides (optional). Empty -> falls back to the shared LLM_* values.
# The admin/moderator often benefits from a stronger model.
LLM_PERSON_MODEL=
LLM_ADMIN_MODEL=
LLM_SEARCH_MODEL=

# --- Web search provider (Phase 3) ---
# One of: none | tavily | searxng
# In this workspace a SearXNG container is available at http://searxng:8080
# (JSON endpoint: /search?q=<begriff>&format=json).
SEARCH_PROVIDER=searxng
TAVILY_API_KEY=
SEARXNG_BASE_URL=http://searxng:8080

# --- App ---
# Public base path when served behind a reverse proxy under a sub-path (e.g. /agenttable).
BASE_PATH=
# SQLite file location.
DB_PATH=data/agenttable.db
# Hard per-task LLM call budget (quality/cost guardrail, spec §10).
TASK_LLM_BUDGET=60
# Timezone label used for slot display (logic is tz-naive Europe/Berlin in MVP).
APP_TIMEZONE=Europe/Berlin
